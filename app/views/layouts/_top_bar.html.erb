<header class="relative flex h-12 shrink-0 items-center gap-3 border-b border-line bg-surface px-3 md:gap-6 md:px-4" data-controller="toggle">
  <button type="button" class="btn btn-sm size-8 p-0 lg:hidden" data-action="toggle#toggle"
          title="<%= t("nav.menu") %>" aria-label="<%= t("nav.menu") %>" aria-expanded="false" data-toggle-target="button"><%= icon(:menu, size: "size-4") %></button>
  <%= link_to root_path, class: "flex shrink-0 items-center gap-2 font-semibold text-ink-strong" do %>
    <span class="size-5 rounded bg-gradient-to-br from-accent to-rx"></span>
    <span class="hidden sm:inline"><%= t("app_name") %></span>
  <% end %>

  <nav class="hidden items-center gap-5 self-stretch lg:flex">
    <% nav_items.each do |item| %>
      <%= link_to item[:label], item[:path], class: class_names("nav-link flex items-center", active: item[:active]) %>
    <% end %>
  </nav>

  <div class="ml-auto flex items-center gap-2 text-muted md:gap-4">
    <% if can?(:view_dispatch) %>
      <%= turbo_stream_from :servers_status, I18n.locale.to_s %>
      <%= render "layouts/servers_status" %>
    <% end %>
    <span class="hidden tabular-nums sm:inline" data-controller="clock"></span>
    <%= theme_toggle %>
    <%= link_to profile_path, class: "flex items-center gap-2 hover:text-ink-strong", title: Current.user.name do %>
      <span class="flex size-7 items-center justify-center rounded-full bg-accent text-xs font-semibold text-white"><%= initials(Current.user.name) %></span>
    <% end %>
    <%= button_to t("sessions.sign_out"), session_path, method: :delete, class: "btn btn-sm" %>
  </div>

  <nav class="absolute inset-x-0 top-12 z-30 flex flex-col border-b border-line bg-surface p-2 shadow-lg lg:hidden" data-toggle-target="panel" hidden>
    <% nav_items.each do |item| %>
      <%= link_to item[:label], item[:path], class: class_names("rounded-md px-3 py-2 hover:bg-raised", "bg-raised text-ink-strong": item[:active]) %>
    <% end %>
  </nav>
</header>
