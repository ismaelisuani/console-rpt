<header class="relative z-20 flex h-14 shrink-0 items-center gap-3 topbar border-b px-3 shadow-card md:gap-5 md:px-5" data-controller="toggle">
  <button type="button" class="btn btn-sm size-8 p-0 lg:hidden" data-action="toggle#toggle"
          title="<%= t("nav.menu") %>" aria-label="<%= t("nav.menu") %>" aria-expanded="false" data-toggle-target="button"><%= icon(:menu, size: "size-4") %></button>
  <%= link_to root_path, class: "flex shrink-0 items-center", title: t("app_name") do %>
    <%= brand_logo("h-6 w-auto", on_color: true) %>
  <% end %>

  <nav class="hidden items-center gap-1 lg:flex">
    <% nav_items.each do |item| %>
      <%= link_to item[:label], item[:path], class: class_names("topbar-link flex items-center", active: item[:active]) %>
    <% end %>
  </nav>

  <div class="ml-auto flex items-center gap-2 md:gap-4">
    <% if can?(:view_dispatch) %>
      <%= turbo_stream_from :servers_status, I18n.locale.to_s %>
      <%= render "layouts/servers_status" %>
    <% end %>
    <span class="hidden tabular-nums sm:inline" data-controller="clock"></span>
    <%= theme_toggle %>
    <%= link_to profile_path, class: "flex items-center gap-2", title: Current.user.name do %>
      <span class="flex size-7 items-center justify-center rounded-full bg-white text-xs font-semibold text-accent"><%= initials(Current.user.name) %></span>
    <% end %>
    <%= button_to t("sessions.sign_out"), session_path, method: :delete, class: "btn btn-sm" %>
  </div>

  <nav class="absolute inset-x-0 top-14 z-30 flex flex-col border-b border-line bg-surface p-2 text-ink shadow-lg lg:hidden" data-toggle-target="panel" hidden>
    <% nav_items.each do |item| %>
      <%= link_to item[:label], item[:path], class: class_names("rounded-md px-3 py-2 hover:bg-raised", "bg-raised text-ink-strong": item[:active]) %>
    <% end %>
  </nav>
</header>
