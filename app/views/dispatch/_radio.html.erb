<%# Per user: permissions decide the controls. The live part is dispatch/radio_state. %>
<% access = radio_tile_access(radio) %>
<article id="<%= dom_id(radio) %>"
         class="<%= radio_tile_classes(radio) %>"
         style="<%= radio_tile_style(@dispatch_layout, radio) %>"
         tabindex="0" aria-label="<%= radio.name %>" data-node="<%= radio.node %>" data-name="<%= radio.name %>"
         data-unlink-url="<%= radio_links_path(radio) %>" data-link-url="<%= radio_links_path(radio) %>"
         data-link-drop-label="<%= t("dispatch.radio.drop_to_link", radio: radio.name) %>"
         data-arrange-target="tile" data-radio-id="<%= radio.id %>" <%= radio_tile_position_data(@dispatch_layout, radio) %>
         data-controller="radio" data-dispatch-target="radio"
         data-radio-id-value="<%= radio.id %>"
         data-radio-call-url-value="<%= radio_call_path(radio) %>"
         data-radio-ptt-url-value="<%= radio_ptt_path(radio) %>"
         data-action="click->radio#focus">
  <%= turbo_stream_from radio.broadcast_stream %>
  <audio data-radio-target="audio" autoplay hidden></audio>
  <%# The whole header is the handle to move the tile (wide screens) %>
  <header class="-mx-3 -mt-4 flex min-w-0 items-center gap-2 px-3 pt-4 pb-1 select-none lg:cursor-move lg:hover:bg-raised/60"
          title="<%= t("dispatch.radio.move") %>" data-action="pointerdown->arrange#arm">
    <h2 class="truncate text-base font-semibold text-ink-strong"><%= radio.name %></h2>
    <span class="shrink-0 text-faint tabular-nums"><%= radio.node %></span>
    <span class="ml-auto shrink-0 text-faint"><%= radio.server.name %></span>
  </header>

  <div class="flex items-center gap-1.5 text-xs">
    <%= radio_mode_badge(radio) %>
    <% if access[:transmit] %>
      <button type="button" class="badge ml-auto cursor-pointer border border-line-strong text-muted hover:border-accent aria-pressed:border-accent aria-pressed:bg-accent aria-pressed:text-white"
              data-radio-target="groupButton" data-action="radio#toggleGroup" aria-pressed="false" title="<%= t("dispatch.radio.group_ptt_hint") %>">
        <%= t("dispatch.radio.group_ptt") %>
      </button>
    <% end %>
    <span class="badge bg-raised text-muted" title="<%= t("dispatch.radio.console_audio") %>"><%= icon(:headphones) %><span data-radio-target="connectionBadge"><%= t("dispatch.radio.disconnected") %></span></span>
  </div>

  <%= render "dispatch/radio_state", radio: radio %>
  <p class="rounded bg-tx-soft px-2 py-1 text-xs text-tx-ink" data-radio-target="problem" hidden></p>

  <div class="mt-auto flex items-center gap-2 text-muted">
    <button type="button" class="btn btn-sm size-7 p-0" data-radio-target="muteButton" data-action="radio#toggleMute"
            title="<%= t("dispatch.radio.mute") %>" aria-label="<%= t("dispatch.radio.mute") %>">
      <span data-radio-target="speakerIcon"><%= icon(:speaker) %></span>
      <span data-radio-target="mutedIcon" hidden><%= icon(:speaker_muted) %></span>
    </button>
    <input type="range" min="0" max="100" value="70" class="h-1 flex-1 accent-accent" data-radio-target="volume"
           data-action="input->radio#setVolume" aria-label="<%= t("dispatch.radio.volume") %>">
    <span class="w-14 text-right text-xs tabular-nums text-ink" data-radio-target="volumeLabel"></span>
  </div>

  <%# The three main controls, same size %>
  <div class="grid grid-cols-3 gap-2">
    <button type="button" class="btn h-11 rounded-xl tile-btn" data-radio-target="connectButton" data-action="radio#toggleConnection"
            <%= "disabled" unless access[:listen] && access[:webrtc] %>
            title="<%= t("dispatch.radio.no_webrtc") unless access[:webrtc] %>"
            data-connect-label="<%= t("dispatch.radio.connect") %>" data-disconnect-label="<%= t("dispatch.radio.disconnect") %>"
            data-connect-title="<%= t("dispatch.radio.no_webrtc") unless access[:webrtc] %>" data-disconnect-title="<%= t("dispatch.radio.stop_listening") %>"
            aria-pressed="false">
      <%= icon(:headphones, size: "size-4") %>
      <%= t("dispatch.radio.connect") %>
    </button>
    <button type="button" class="btn h-11 rounded-xl tile-btn" data-action="radio#openLink" <%= "disabled" unless access[:link] %>>
      <%= icon(:chain, size: "size-4") %><%= t("dispatch.radio.link") %>
    </button>
    <% if access[:transmit] %>
      <button type="button" class="btn tile-btn h-11 gap-1.5 rounded-xl py-0 text-lg font-bold tracking-wide enabled:border-accent enabled:bg-accent enabled:text-white enabled:shadow-sm enabled:hover:bg-accent/90 data-[pressed]:border-tx-strong data-[pressed]:bg-tx-strong data-[pressed]:shadow-[0_0_0_4px] data-[pressed]:shadow-tx/25" data-radio-target="ptt"
              data-action="pointerdown->radio#pttDown pointerup->radio#pttUp pointerleave->radio#pttUp" disabled
              title="<%= t("dispatch.radio.connect_first") %>">
        <%= icon(:mic, size: "size-5") %><%= t("dispatch.radio.ptt") %>
      </button>
    <% else %>
      <button type="button" class="btn tile-btn h-11 gap-1.5 rounded-xl border-dashed py-0 text-lg font-bold tracking-wide text-warn-ink/70!" disabled
              title="<%= t("dispatch.radio.no_permission") %>">
        <%= icon(:lock, size: "size-5") %><%= t("dispatch.radio.ptt") %>
      </button>
    <% end %>
  </div>


  <% if access[:link] %>
    <dialog class="m-auto w-80 rounded-lg border border-line bg-surface p-4 text-ink backdrop:bg-canvas/70" data-radio-target="linkDialog">
      <%= form_with url: radio_links_path(radio), class: "space-y-3" do |form| %>
        <h3 class="font-semibold text-ink-strong"><%= t("dispatch.radio.link_title", radio: radio.name) %></h3>
        <%= form.select :other_radio_id, radio_link_options(radio), {}, class: "input" %>
        <div class="flex gap-4">
          <label class="flex items-center gap-2"><%= form.radio_button :mode, "transceive", checked: true, class: "accent-accent" %><%= t("dispatch.radio.transceive") %></label>
          <label class="flex items-center gap-2"><%= form.radio_button :mode, "monitor", class: "accent-accent" %><%= t("dispatch.radio.monitor") %></label>
        </div>
        <div class="flex justify-end gap-2">
          <button type="button" class="btn" data-action="radio#closeLink"><%= t("actions.cancel") %></button>
          <%= form.submit t("dispatch.radio.link"), class: "btn-primary" %>
        </div>
      <% end %>
    </dialog>
  <% end %>
</article>
