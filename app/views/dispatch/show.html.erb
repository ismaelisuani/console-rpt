<% content_for :title, t("nav.dispatch") %>
<%= dispatch_strings_tag %>
<div class="flex min-h-0 flex-1" data-controller="dispatch" data-action="keydown@window->dispatch#keydown keyup@window->dispatch#keyup">
  <%= render "dispatch/phone" %>

  <main class="flex min-w-0 flex-1 flex-col gap-3 p-3">
    <div class="flex flex-wrap items-center gap-3">
      <h1 class="text-base font-semibold text-ink-strong"><%= Radio.model_name.human(count: 2) %></h1>
      <% if @groups.any? %>
        <nav class="flex flex-wrap gap-1">
          <% @groups.each do |group| %>
            <%= link_to group.name, dispatch_path(group_id: group.id), class: class_names("btn btn-sm", "bg-raised text-ink-strong": group == @group) %>
          <% end %>
        </nav>
      <% end %>
      <span class="text-muted"><%= t(".count", count: @radios.size, online: @radios.count(&:online?)) %></span>
      <div class="ml-auto flex items-center gap-2">
        <button type="button" class="btn btn-sm" data-action="dispatch#connectAll"><%= t(".listen_all") %></button>
        <button type="button" class="btn btn-sm" data-action="dispatch#muteAll"><%= t(".mute_all") %></button>
        <% if @dispatch_layout.persisted? %>
          <%= button_to t(".reset_layout"), dispatch_layout_path(group_id: @group&.id), method: :delete, class: "btn btn-sm" %>
        <% end %>
        <div class="flex gap-1" title="<%= t(".layout") %>">
          <% DispatchController::LAYOUTS.each do |layout| %>
            <%= link_to layout, dispatch_path(group_id: @group&.id, layout: layout), class: class_names("btn btn-sm", "bg-raised text-ink-strong": layout == @layout) %>
          <% end %>
        </div>
      </div>
    </div>

    <% if @radios.empty? %>
      <div class="card flex flex-1 items-center justify-center p-10 text-muted"><%= t(".empty") %></div>
    <% else %>
      <div class="grid min-h-0 flex-1 gap-3 overflow-y-auto" style="<%= dispatch_grid_style(@layout) %>"
           data-controller="arrange" data-arrange-url-value="<%= dispatch_layout_path(group_id: @group&.id) %>"
           data-arrange-columns-value="<%= dispatch_grid_columns(@layout) %>"
           data-action="dragstart->arrange#dragStart dragover->arrange#dragOver drop->arrange#drop dragend->arrange#dragEnd">
        <% @radios.each do |radio| %>
          <%= render "dispatch/radio", radio: radio %>
        <% end %>
      </div>
    <% end %>

    <section class="card relative flex h-28 shrink-0 flex-col" data-controller="resizable-panel" data-resizable-panel-key-value="dispatch-activity-height">
      <div class="absolute inset-x-0 -top-1.5 h-3 cursor-row-resize" title="<%= t(".resize_activity") %>" data-action="pointerdown->resizable-panel#dragStart"></div>
      <div class="flex items-center gap-2 px-3 pt-2">
        <h2 class="text-xs font-semibold uppercase tracking-wide text-ink-strong"><%= t(".activity") %></h2>
        <div class="ml-auto flex gap-1">
          <button type="button" class="btn btn-sm px-1.5 py-0" data-action="resizable-panel#grow" title="<%= t(".activity_bigger") %>" aria-label="<%= t(".activity_bigger") %>">▲</button>
          <button type="button" class="btn btn-sm px-1.5 py-0" data-action="resizable-panel#shrink" title="<%= t(".activity_smaller") %>" aria-label="<%= t(".activity_smaller") %>">▼</button>
        </div>
      </div>
      <ol id="activity" class="min-h-0 flex-1 space-y-0.5 overflow-y-auto px-3 pb-2 text-xs text-muted">
        <% @events.each do |event| %>
          <%= render "dispatch/activity_entry", event: event %>
        <% end %>
      </ol>
    </section>
  </main>
</div>
