<% content_for :title, t("nav.dispatch") %>
<%= dispatch_strings_tag %>
<div class="flex min-h-0 flex-1 flex-col md:flex-row" data-controller="dispatch toggle" data-toggle-class-value="max-md:hidden" data-group="<%= @group&.id %>" data-action="keydown@window->dispatch#keydown keyup@window->dispatch#keyup blur@window->dispatch#releaseAll radio:general->dispatch#updateGeneral">
  <% if can?(:phone) %><%= render "dispatch/phone" %><% end %>

  <main class="flex min-w-0 flex-1 flex-col gap-3 p-3">
    <div class="flex flex-wrap items-center gap-3">
      <% if can?(:phone) %><button type="button" class="btn btn-sm md:hidden" data-action="toggle#toggle" data-toggle-target="button" aria-expanded="false"><%= t("phone.title") %></button><% end %>
      <h1 class="sr-only"><%= Radio.model_name.human(count: 2) %></h1>
      <% if @groups.any? %>
        <nav class="flex flex-wrap gap-1">
          <%= link_to t(".all"), dispatch_path, class: class_names("btn btn-sm", "bg-raised text-ink-strong": @group.nil?) %>
          <% @groups.each do |group| %>
            <%= link_to group.name, dispatch_path(group_id: group.id), class: class_names("btn btn-sm", "bg-raised text-ink-strong": group == @group) %>
          <% end %>
        </nav>
      <% end %>
      <span class="text-muted"><%= t(".count", count: @radios.size, online: @radios.count(&:online?)) %></span>
      <div class="flex flex-wrap items-center gap-2 lg:ml-auto">
        <button type="button" class="btn btn-sm" data-action="dispatch#connectAll"><%= t(".listen_all") %></button>
        <button type="button" class="btn btn-sm" data-action="dispatch#muteAll"><%= t(".mute_all") %></button>
      </div>
    </div>

    <% if @radios.any? { |radio| radio_tile_access(radio)[:transmit] } %>
      <div class="card flex flex-wrap items-center gap-3 px-3 py-2">
        <button type="button" class="btn flex-col gap-0 rounded-xl border-accent/60 px-5 py-1 font-bold text-accent-ink active:border-tx active:bg-tx-strong active:text-white"
                data-dispatch-target="generalButton" disabled
                data-action="pointerdown->dispatch#generalDown pointerup->dispatch#generalUp pointerleave->dispatch#generalUp">
          <span class="text-base"><%= t(".general_ptt") %></span>
          <span class="text-[10px] font-normal text-muted"><%= t(".shift_space") %></span>
        </button>
        <div class="flex min-w-0 flex-1 flex-col gap-1">
          <span class="text-xs text-muted" data-dispatch-target="spaceHint"></span>
          <div class="flex flex-wrap gap-1" data-dispatch-target="generalList"></div>
        </div>
      </div>
    <% end %>

    <% if @radios.empty? %>
      <div class="card flex flex-1 items-center justify-center p-10 text-muted"><%= t(".empty") %></div>
    <% else %>
      <div class="relative <%= dispatch_grid_classes %>" style="<%= dispatch_grid_style(@layout) %>"
           data-controller="arrange links" data-arrange-url-value="<%= dispatch_layout_path(group_id: @group&.id) %>"
           data-arrange-columns-value="<%= dispatch_grid_columns(@layout) %>"
           data-action="dragstart->arrange#dragStart dragover->arrange#dragOver drop->arrange#drop dragend->arrange#dragEnd">
        <% @radios.each do |radio| %>
          <%= render "dispatch/radio", radio: radio %>
        <% end %>
      </div>
    <% end %>

    <section class="card relative flex h-40 shrink-0 flex-col md:h-28" data-controller="resizable-panel" data-resizable-panel-key-value="dispatch-activity-height">
      <div class="absolute inset-x-0 -top-1.5 h-3 cursor-row-resize" data-action="pointerdown->resizable-panel#dragStart"></div>
      <%= resize_grip(t(".resize_activity"), "resizable-panel#dragStart", corner: :top_right) %>
      <div class="flex items-center gap-2 px-3 pt-2">
        <h2 class="text-xs font-semibold uppercase tracking-wide text-ink-strong"><%= t(".activity") %></h2>
      </div>
      <ol id="activity" class="min-h-0 flex-1 space-y-0.5 overflow-y-auto px-3 pb-2 text-xs text-muted">
        <% @events.each do |event| %>
          <%= render "dispatch/activity_entry", event: event %>
        <% end %>
      </ol>
    </section>
  </main>
</div>
