<aside class="relative flex w-full shrink-0 flex-col gap-2 border-b border-line bg-panel p-3 max-md:hidden md:w-(--panel-width) md:border-r md:border-b-0 [--panel-width:15rem]"
       data-toggle-target="panel"
       data-controller="phone resizable-panel" data-phone-account-url-value="<%= phone_account_path %>" data-phone-available-value="<%= phone_available? %>"
       data-resizable-panel-key-value="dispatch-phone-width" data-resizable-panel-axis-value="x"
       data-resizable-panel-min-value="200" data-resizable-panel-max-value="0.4" data-resizable-panel-step-value="60">
  <div class="absolute inset-y-0 -right-1.5 z-10 hidden w-3 cursor-col-resize md:block" data-action="pointerdown->resizable-panel#dragStart"></div>
  <div class="hidden md:block"><%= resize_grip(t("phone.resize"), "resizable-panel#dragStart", corner: :bottom_right) %></div>

  <%# Who is connected, and whether the extension is registered (green) or not (red) %>
  <div class="flex flex-col gap-0.5">
    <div class="flex items-center gap-2">
      <h2 class="font-semibold text-ink-strong"><%= t("phone.title") %></h2>
      <span class="size-2 shrink-0 rounded-full bg-tx" data-phone-target="statusDot"></span>
      <span class="truncate text-xs text-muted" data-phone-target="status"></span>
    </div>
    <span class="truncate text-xs text-faint" data-phone-target="identity"><%= Current.user.name %></span>
  </div>

  <div class="rounded-xl border border-line bg-raised/60 p-2.5">
    <div class="text-xs text-muted" data-phone-target="callState"><%= t("phone.idle") %></div>
    <input type="tel" class="w-full bg-transparent text-xl text-ink-strong outline-none" data-phone-target="number" data-action="keyup->phone#typed"
           placeholder="<%= t("phone.number") %>" aria-label="<%= t("phone.number") %>">
  </div>

  <div class="flex flex-col gap-2 rounded-xl border-2 border-rx bg-rx-soft p-2.5" data-phone-target="incoming" hidden>
    <span class="text-xs font-semibold text-rx-ink"><%= t("phone.incoming") %></span>
    <span class="truncate text-lg font-semibold text-ink-strong" data-phone-target="incomingFrom"></span>
    <div class="grid grid-cols-2 gap-1.5">
      <button type="button" class="btn border-rx bg-rx text-white" data-action="phone#answer"><%= t("phone.answer") %></button>
      <button type="button" class="btn border-tx-strong bg-tx-strong text-white" data-action="phone#reject"><%= t("phone.reject") %></button>
    </div>
  </div>

  <div class="grid grid-cols-3 gap-1.5">
    <% [ %w[1], %w[2 ABC], %w[3 DEF], %w[4 GHI], %w[5 JKL], %w[6 MNO], %w[7 PQRS], %w[8 TUV], %w[9 WXYZ], %w[*], %w[0], %w[#] ].each do |key, letters| %>
      <button type="button" class="flex flex-col items-center rounded-xl border border-line bg-surface py-1.5 text-lg leading-tight text-ink-strong shadow-xs transition-colors hover:border-accent/50 hover:bg-raised"
              data-action="phone#press" data-key="<%= key %>">
        <%= key %><span class="h-3 text-[9px] text-faint"><%= letters %></span>
      </button>
    <% end %>
  </div>
  <div class="grid grid-cols-2 gap-1.5">
    <button type="button" class="btn border-rx bg-rx/80 text-white hover:bg-rx" data-action="phone#dial" disabled data-phone-target="callButton"><%= t("phone.call") %></button>
    <button type="button" class="btn border-tx-strong bg-tx-strong text-white hover:bg-tx" data-action="phone#hangup" disabled data-phone-target="hangupButton"><%= t("phone.hangup") %></button>
    <button type="button" class="btn aria-pressed:border-tx-strong aria-pressed:text-tx-ink" disabled data-phone-target="muteButton" data-action="phone#toggleMute" aria-pressed="false"><%= t("phone.mute") %></button>
    <button type="button" class="btn" disabled title="<%= t("phone.transfer_soon") %>"><%= t("phone.transfer") %></button>
  </div>

  <%# One click to call: favorites, the other dispatchers, recent numbers %>
  <div class="-mx-1 min-h-0 flex-1 space-y-3 overflow-y-auto border-t border-line px-1 pt-2 text-xs">
    <section class="space-y-1">
      <div class="flex items-center justify-between">
        <h3 class="font-semibold text-ink-strong">★ <%= t("phone.favorites") %></h3>
        <%= link_to t("phone.address_book"), contacts_path, class: "text-accent-ink hover:underline" %>
      </div>
      <% favorites = Current.user.favorite_contacts.ordered %>
      <% favorites.each do |contact| %>
        <%= phone_dial_button(contact.name, contact.number, contact.organization) %>
      <% end %>
      <% if favorites.empty? %><p class="text-faint"><%= t("phone.no_favorites") %></p><% end %>
    </section>
    <% colleagues = Current.user.colleagues_with_phone %>
    <% if colleagues.any? %>
      <section class="space-y-1">
        <h3 class="font-semibold text-ink-strong"><%= t("phone.extensions") %></h3>
        <% colleagues.each do |user| %>
          <%= phone_dial_button(user.name, user.sip_extension, t("phone.extension_short", number: user.sip_extension)) %>
        <% end %>
      </section>
    <% end %>
    <section class="space-y-1">
      <h3 class="font-semibold text-ink-strong"><%= t("phone.recent") %></h3>
      <div data-phone-target="recent"></div>
    </section>
  </div>
  <audio data-phone-target="audio" autoplay hidden></audio>
  <%= phone_strings_tag %>
</aside>
