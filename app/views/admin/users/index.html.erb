<%= render layout: "shared/admin_page" do %>
  <%= render "shared/page_header", title: User.model_name.human(count: 2), new_path: new_admin_user_path %>
  <div class="card overflow-x-auto">
    <table class="table">
      <thead><tr>
        <th><%= User.human_attribute_name(:name) %></th>
        <th><%= User.human_attribute_name(:email_address) %></th>
        <th><%= User.human_attribute_name(:role) %></th>
        <th><%= RadioGroup.model_name.human(count: 2) %></th>
        <th><%= User.human_attribute_name(:locale) %></th>
        <th></th>
      </tr></thead>
      <tbody>
        <% @users.each do |user| %>
          <tr class="<%= "opacity-50" unless user.active? %>">
            <td class="font-medium text-ink-strong"><%= user.name %></td>
            <td class="text-muted"><%= user.email_address %></td>
            <td><%= user.role.name %></td>
            <td>
              <% if user.all_radios? %>
                <span class="text-muted"><%= t("admin.users.index.all_radios") %></span>
              <% else %>
                <% user.radio_group_accesses.each do |access| %>
                  <span class="badge mr-1 <%= access.level == "operate" ? "bg-accent-soft text-accent-ink" : "bg-warn-soft text-warn-ink" %>"><%= access.radio_group.name %></span>
                <% end %>
              <% end %>
            </td>
            <td class="text-muted"><%= t("locales.#{user.locale}") %></td>
            <td><%= render "shared/row_actions", record: user, edit_path: edit_admin_user_path(user), destroy_path: admin_user_path(user) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
