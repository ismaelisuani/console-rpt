<%= form_with model: [ :admin, user ], class: "card max-w-2xl space-y-4 p-5" do |form| %>
  <%= render "shared/errors", record: user %>
  <div class="grid grid-cols-2 gap-4">
    <div class="field"><%= form.label :name %><%= form.text_field :name, class: "input", required: true %></div>
    <div class="field"><%= form.label :username %><%= form.text_field :username, class: "input", required: true, autocapitalize: "none", autocomplete: "off" %></div>
    <div class="field"><%= form.label :email_address %><%= form.email_field :email_address, class: "input", placeholder: t(".optional") %></div>
    <div class="field"><%= form.label :role_id %><%= form.collection_select :role_id, Role.order(:name), :id, :name, {}, class: "input" %></div>
    <div class="field"><%= form.label :locale %><%= form.select :locale, locale_options, {}, class: "input" %></div>
    <div class="field">
      <%= form.label :password %>
      <%= form.password_field :password, class: "input", required: user.new_record?, autocomplete: "new-password", maxlength: 72,
            placeholder: (t(".keep_password") if user.persisted?) %>
    </div>
    <div class="field"><%= form.label :password_confirmation %><%= form.password_field :password_confirmation, class: "input", autocomplete: "new-password", maxlength: 72 %></div>
  </div>

  <div class="field border-t border-line pt-4">
    <span class="label"><%= t(".radio_access") %></span>
    <p class="text-xs text-muted"><%= t(".radio_access_hint") %></p>
    <% levels = user.group_levels %>
    <div class="mt-2 grid grid-cols-2 gap-2">
      <% RadioGroup.ordered.each do |group| %>
        <label class="flex items-center justify-between gap-3 rounded-md border border-line px-3 py-2">
          <span><%= group.name %></span>
          <%= select_tag "user[group_levels][#{group.id}]",
                radio_group_level_options(levels[group.id]),
                class: "input w-40 py-1" %>
        </label>
      <% end %>
    </div>
  </div>

  <label class="flex items-center gap-2"><%= form.check_box :active, class: "checkbox" %><span><%= User.human_attribute_name(:active) %></span></label>
  <%= render "shared/form_actions", form: form, cancel_path: admin_users_path %>
<% end %>
