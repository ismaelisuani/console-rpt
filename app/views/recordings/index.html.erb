<% turbo_refreshes_with method: :morph, scroll: :preserve %>
<%= turbo_stream_from :recordings %>
<%= render layout: "shared/admin_page" do %>
  <%= render "shared/page_header", title: t("nav.recordings") %>

  <%= form_with url: recordings_path, method: :get, class: "card mb-4 grid grid-cols-1 items-end gap-3 p-3 sm:grid-cols-2 lg:grid-cols-[repeat(5,minmax(0,1fr))_auto_auto]" do |form| %>
    <div class="field"><%= form.label :radio_id, Radio.model_name.human %><%= form.select :radio_id, options_for_select(recording_radio_options, @filters[:radio_id]), {}, class: "input py-1.5" %></div>
    <div class="field"><%= form.label :direction, t("recordings.index.direction") %><%= form.select :direction, options_for_select(recording_direction_options, @filters[:direction]), {}, class: "input py-1.5" %></div>
    <div class="field"><%= form.label :from, t("recordings.index.from") %><%= form.date_field :from, value: @filters[:from], class: "input py-1.5" %></div>
    <div class="field"><%= form.label :to, t("recordings.index.to") %><%= form.date_field :to, value: @filters[:to], class: "input py-1.5" %></div>
    <div class="field"><%= form.label :unit, Unit.model_name.human %><%= form.search_field :unit, value: @filters[:unit], placeholder: t("recordings.index.unit_hint"), class: "input py-1.5" %></div>
    <%= form.submit t("recordings.index.filter"), name: nil, class: "btn-primary" %>
    <%= link_to t("recordings.index.clear"), recordings_path, class: "btn" %>
  <% end %>

  <div class="card overflow-x-auto">
    <table class="table">
      <thead><tr>
        <th><%= t("recordings.index.time") %></th>
        <th><%= Radio.model_name.human %></th>
        <th></th>
        <th><%= t("recordings.index.source") %></th>
        <th><%= t("recordings.index.duration") %></th>
        <th><%= t("recordings.index.audio") %></th>
      </tr></thead>
      <tbody>
        <% @page.records.each do |recording| %>
          <tr id="<%= dom_id(recording) %>" class="<%= "recording-new" if recording.created_at > 1.minute.ago %>">
            <td class="whitespace-nowrap"><%= local_time_tag(recording.started_at, format: "seconds") %></td>
            <td class="font-medium text-ink-strong"><%= recording_radio_name(recording) %></td>
            <td><%= recording_direction_badge(recording) %></td>
            <td class="min-w-48"><%= recording_source(recording) %></td>
            <td class="tabular-nums text-muted"><%= recording_duration(recording) %></td>
            <td>
              <div class="flex items-center gap-2">
                <audio id="<%= dom_id(recording, :audio) %>" controls preload="none" class="h-8 w-56 lg:w-72" src="<%= recording_audio_path(recording) %>"></audio>
                <%= link_to "⤓", recording_audio_path(recording, download: 1), class: "btn btn-sm", title: t("recordings.index.download"), data: { turbo: false } %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <% if @page.records.empty? %><p class="p-6 text-center text-muted"><%= t("recordings.index.empty") %></p><% end %>
  </div>
  <%= pagination_nav(@page) %>
<% end %>
